    <!-- تحميل مكتبة الـ Three.js للأنيميشن التفاعلي 3D Particles -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <!-- تحميل مكتبة الأنيماشن عند السكرول AOS -->
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    
    <script>
        // تفعيل أنيماشن العناصر عند النزول لأسفل الصفحة
        AOS.init({
            once: true
        });

        // --- كود تهيئة وإعداد خلفية Three.js ثلاثية الأبعاد التفاعلية ---
        const container = document.getElementById('canvas-container');
        const scene = new THREE.Scene();
        
        // الكاميرا
        const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
        camera.position.z = 5;

        // الـ Renderer
        const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
        renderer.setSize(window.innerWidth, window.innerHeight);
        container.appendChild(renderer.domElement);

        // إنشاء جزيئات هندسية هندسية ثلاثية الأبعاد (Particles)
        const particlesGeometry = new THREE.BufferGeometry();
        const particlesCount = 180; // عدد الجزيئات العائمة في الخلفية
        
        const posArray = new Float32Array(particlesCount * 3);
        
        // توزيع الجزيئات عشوائياً في الفراغ ثلاثي الأبعاد
        for(let i=0; i < particlesCount * 3; i++) {
            posArray[i] = (Math.random() - 0.5) * 10;
        }
        
        particlesGeometry.setAttribute('position', new THREE.BufferAttribute(posArray, 3));
        
        // تصميم الجزيئات وربط الألوان بالهوية البصرية (النيون والأورانج المدمج)
        const particlesMaterial = new THREE.PointsMaterial({
            size: 0.04,
            color: 0x00f0ff, // اللون الأزرق النيون كقاعدة أساسية
            transparent: true,
            opacity: 0.7,
            blending: THREE.AdditiveBlending
        });
        
        const particlesMesh = new THREE.Points(particlesGeometry, particlesMaterial);
        scene.add(particlesMesh);

        // إضافة إضاءة محيطية خفيفة لتعزيز العمق الرقمي
        const ambientLight = new THREE.AmbientLight(0xffffff, 0.1);
        scene.add(ambientLight);

        // تتبع حركة الماوس لإنشاء تأثير التفاعل (Interactive Parallax)
        let mouseX = 0;
        let mouseY = 0;
        
        window.addEventListener('mousemove', (event) => {
            mouseX = (event.clientX / window.innerWidth) - 0.5;
            mouseY = (event.clientY / window.innerHeight) - 0.5;
        });

        // تتبع السكرول (التمرير) لتحريك الأجسام في الخلفية
        let scrollY = 0;
        window.addEventListener('scroll', () => {
            scrollY = window.scrollY;
        });

        // دالة التحريك وتحديث الإطارات الـ Loop
        const clock = new THREE.Clock();

        const animate = () => {
            requestAnimationFrame(animate);
            
            const elapsedTime = clock.getElapsedTime();
            
            // دوران ناعم تلقائي مستمر للجزيئات ثلاثية الأبعاد
            particlesMesh.rotation.y = elapsedTime * 0.05;
            particlesMesh.rotation.x = elapsedTime * 0.02;
            
            // التأثر بحركة الماوس بنعومة فائقة
            particlesMesh.rotation.y += mouseX * 0.5;
            particlesMesh.rotation.x += -mouseY * 0.5;
            
            // التأثر بعملية الـ Parallax Scrolling أثناء النزول
            particlesMesh.position.y = -scrollY * 0.0015;

            renderer.render(scene, camera);
        };

        animate();

        // إعادة ضبط الحجم تلقائياً عند تغيير حجم الشاشة أو تدوير الهاتف
        window.addEventListener('resize', () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        });
    </script>
</body>
</html>
